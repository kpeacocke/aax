diff --git a/libpod/storage_config.go b/libpod/storage_config.go
new file mode 100644
index 0000000..760b5a7
--- /dev/null
+++ b/libpod/storage_config.go
@@ -0,0 +1,35 @@
+//go:build !remote
+
+package libpod
+
+import (
+	"errors"
+	"os"
+
+	"go.podman.io/storage/pkg/configfile"
+	"go.podman.io/storage/pkg/unshare"
+)
+
+// storageConfigFile preserves the v5 info field while storage supports layered files.
+func storageConfigFile() (string, error) {
+	paths, err := configfile.GetSearchPaths(&configfile.File{
+		Name:            "storage",
+		Extension:       "conf",
+		EnvironmentName: "CONTAINERS_STORAGE_CONF",
+		UserId:          unshare.GetRootlessUID(),
+	})
+	if err != nil {
+		return "", err
+	}
+	for _, path := range paths.MainFiles {
+		if _, err := os.Stat(path); err == nil {
+			return path, nil
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return "", err
+		}
+	}
+	if len(paths.MainFiles) != 0 {
+		return paths.MainFiles[0], nil
+	}
+	return "", nil
+}
diff --git a/libpod/storage_config_test.go b/libpod/storage_config_test.go
new file mode 100644
index 0000000..0af0ae0
--- /dev/null
+++ b/libpod/storage_config_test.go
@@ -0,0 +1,25 @@
+//go:build !remote
+
+package libpod
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestStorageConfigFileOverride(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "storage.conf")
+	t.Setenv("CONTAINERS_STORAGE_CONF", path)
+	for _, exists := range []bool{false, true} {
+		if exists {
+			if err := os.WriteFile(path, []byte("[storage]\n"), 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+		got, err := storageConfigFile()
+		if err != nil || got != path {
+			t.Fatalf("override exists=%v: got %q, %v; want %q", exists, got, err, path)
+		}
+	}
+}
